# any depth. This one is the runner `make test` calls, so it must be tracked.
/test.sh
.luarc.json
# Anchored: an unanchored `nvim` matches any file OR DIRECTORY named nvim at
# any depth, which would shadow a future nvim/ source dir.
/nvim

spell/

# ml4w/git renames .git -> .git.bak-mydotfiles when it takes ownership of a
# directory. That stranded 620KB of history shows as untracked and would be
# swept into a commit. Never tracked, never pushed.
.git.bak-mydotfiles/

