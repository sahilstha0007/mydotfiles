# Runtime state — lives here, never tracked.
/.config/tmux/plugins/
/.config/wezterm/backdrops/
/.config/wezterm/.github/
/.config/wezterm/*.log
/.config/nvim/.git/
/.config/nvim/.git.bak-mydotfiles/
/.config/wezterm/.git.bak-mydotfiles/

# Python caches
__pycache__/
*.pyc

# VSCode runtime caches (settings and keybindings are tracked)
/.config/Code/User/History/
/.config/Code/User/workspaceStorage/
/.config/Code/User/globalStorage/

# AI tooling artifacts.
.claude/
.agents/
skills-lock.json
AGENTS.md
CLAUDE.md

# herdr runtime state (regenerated).
/.config/herdr/herdr-client.log
/.config/herdr/herdr-server.log
/.config/herdr/session.json
/.config/herdr/release-notes.json
/.config/herdr/.plugins.lock
/.config/herdr/sessions/

# Playwright / Node noise.
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/.config/kitty/colors-matugen.conf
/.config/btop/themes/matugen.theme
