{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-bak.sh\""
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-lua.sh\""
      },
      {
        "matcher": "Edit|Write",
        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-lua.sh\""
      },
      {
        "matcher": "Edit|Write",
        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-imports.sh\""
      }
    ]
  }
}
