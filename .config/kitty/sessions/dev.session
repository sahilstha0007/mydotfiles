# =============================================================================
# Kitty Dev Session: Multi-Tab Development Workspace
# Pre-configured multi-tab layout: Editor, Services & Splits, Git & Monitor
# =============================================================================

# Tab 1: Editor / Code (Primary)
new_tab editor
layout stack
cd ~
launch zsh

# Tab 2: Services / Server
new_tab services
layout stack
cd ~
launch zsh

# Tab 3: Git & Version Control (Lazygit dashboard)
new_tab git
layout stack
cd ~
launch zsh -c "lazygit || zsh"
