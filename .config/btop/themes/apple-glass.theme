# Apple Dark Glass theme for btop (used when TERMINAL_STACK_PROFILE=kitty)

# Main background, empty for terminal default / transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#f5f5f7"

# Title color for boxes
theme[title]="#6c8cff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#8fb2df"

# Background color of selected item in processes box
theme[selected_bg]="#6c8cff"

# Foreground color of selected item in processes box
theme[selected_fg]="#f5f5f7"

# Color of inactive/disabled text
theme[inactive_fg]="#6e6e73"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#64d2ff"

# Box outline colors
theme[cpu_box]="#3a3a3c"
theme[mem_box]="#3a3a3c"
theme[net_box]="#3a3a3c"
theme[proc_box]="#3a3a3c"

# Box divider line and small boxes line color
theme[div_line]="#3a3a3c"

# Temperature graph colors
theme[temp_start]="#7dce8b"
theme[temp_mid]="#f2d97a"
theme[temp_end]="#ff6b6b"

# CPU graph colors
theme[cpu_start]="#64d2ff"
theme[cpu_mid]="#6c8cff"
theme[cpu_end]="#cba6f0"

# Mem/Disk free meter
theme[free_start]="#7dce8b"
theme[free_mid]=""
theme[free_end]="#3a3a3c"

# Mem/Disk cached meter
theme[cached_start]="#f2d97a"
theme[cached_mid]=""
theme[cached_end]="#ff9f0a"

# Mem/Disk available meter
theme[available_start]="#64d2ff"
theme[available_mid]=""
theme[available_end]="#6c8cff"

# Mem/Disk used meter
theme[used_start]="#ff6b6b"
theme[used_mid]=""
theme[used_end]="#cba6f0"

# Download graph colors
theme[download_start]="#7dce8b"
theme[download_mid]="#64d2ff"
theme[download_end]="#6c8cff"

# Upload graph colors
theme[upload_start]="#cba6f0"
theme[upload_mid]="#df97dc"
theme[upload_end]="#ff9f0a"
