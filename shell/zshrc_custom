# ---------------------------------------------------------------------------
# OSC 7 cwd reporting — tells wezterm (and other terminals) the current
# directory, so new wezterm tabs/panes open HERE instead of $HOME.
# tmux inherits cwd via pane_current_path already; this covers plain
# wezterm tabs outside tmux. (See Obsidian: 07 - Gotchas & Fixes.)
# ---------------------------------------------------------------------------
if [[ -n "$WEZTERM_PANE" ]]; then
  _wezterm_osc7() {
    printf '\e]7;file://%s%s\e\\' "$HOST" "$PWD"
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _wezterm_osc7
fi

# ---------------------------------------------------------------------------
# TMUX — shared session across kitty & wezterm (manual opt-in)
# ~/.zshenv sets TMUX_TMPDIR=$HOME/.cache/tmux so both terminals talk to
# the SAME tmux server. No auto-attach here — open a plain shell by default.
# Use `ta` to attach, `tn` to create/new, `tk` to list sessions.
# ---------------------------------------------------------------------------
if command -v tmux >/dev/null 2>&1; then
  alias ta='tmux attach-session -t main 2>/dev/null || tmux new-session -s main'
  alias tn='tmux new-session -s main'
  alias tk='tmux ls'
  alias td='tmux detach-client'
fi

# Zed CLI is zeditor on Arch
alias zed=zeditor

# ---------------------------------------------------------------------------
# jcode: claude-code-style /model (routes through omniroute profile)
# ---------------------------------------------------------------------------
jcode() {
  if [ "$1" = "/model" ]; then
    shift
    if [ $# -eq 0 ]; then
      command jcode --provider-profile omniroute
    else
      local m="$1"; shift
      if [ $# -gt 0 ]; then
        command jcode run --provider-profile omniroute -m "$m" "$@"
      else
        command jcode --provider-profile omniroute -m "$m"
      fi
    fi
    return
  fi
  command jcode "$@"
}


# ---------------------------------------------------------------------------
# Terminal palette isolation
# Wallpaper/matugen (wezterm cascade) is ONLY active inside wezterm.
# Detect host via WEZTERM_PANE (survives tmux); otherwise keep tool defaults.
# Other tools should gate their wezterm-derived config the same way.
# ---------------------------------------------------------------------------
if [[ -n "${WEZTERM_PANE:-}" ]]; then
  export OPENCODE_TUI_CONFIG="$HOME/.config/opencode/tui-wezterm.json"
fi

# Ensure deduplicated PATH across all runtimes and purge non-existent directories
typeset -U path PATH
path=($^path(N-/))
