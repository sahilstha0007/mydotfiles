  ZSH_HIGHLIGHT_STYLES[command]="fg=#d8dee9,bold"
  ZSH_HIGHLIGHT_STYLES[precommand]="fg=#ffb4ab,bold"
  ZSH_HIGHLIGHT_STYLES[hashed-command]="fg=#d8dee9"
  ZSH_HIGHLIGHT_STYLES[autodirectory]="fg=#f3bd6e"
  ZSH_HIGHLIGHT_STYLES[path]="fg=#f3bd6e"
  ZSH_HIGHLIGHT_STYLES[path_prefix]="fg=#f3bd6e"
  ZSH_HIGHLIGHT_STYLES[path_approx]="fg=#ffb4ab"
  ZSH_HIGHLIGHT_STYLES[commandseparator]="fg=#ede0d4"
  ZSH_HIGHLIGHT_STYLES[redirection]="fg=#ede0d4"
  ZSH_HIGHLIGHT_STYLES[history-expansion]="fg=#ffb4ab"
  ZSH_HIGHLIGHT_STYLES[comment]="fg=#9b8f80,italic"
  ZSH_HIGHLIGHT_STYLES[assign]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[arg0]="fg=#d8dee9"
  ZSH_HIGHLIGHT_STYLES[globbing]="fg=#f3bd6e,bold"
  ZSH_HIGHLIGHT_STYLES[back-quoted-argument]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]="fg=#ede0d4"
  ZSH_HIGHLIGHT_STYLES[rc-quote]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[bracket-error]="fg=#ffb4ab,bold"
  ZSH_HIGHLIGHT_STYLES[cursor-matchingbracket]="fg=#ede0d4,bold"

  [ -f "$HOME/.cache/zsh-wallpaper.zsh" ] && source "$HOME/.cache/zsh-wallpaper.zsh"
  export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS --color=bg:-1,gutter:-1,preview-bg:-1"

else
  # --- GENERIC / SSH / TTY FALLBACK ---
  _omp_init_cached "$HOME/.config/ohmyposh/zen.toml" "$HOME/.cache/zsh-cache/omp-fallback.zsh"
fi

unset -f _zsh_cached_init _omp_init_cached

# Syntax-highlighted man pages via bat
if (( $+commands[bat] )); then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
fi

# ---------------------------------------------------------------------------
# 6. Aliases & Functions
# ---------------------------------------------------------------------------

# General navigation & tools
alias ..='cd ..'
alias c='clear'
alias nf='fastfetch'
alias pf='fastfetch'
alias ff='fastfetch'
alias v='$EDITOR'
alias vim='$EDITOR'
alias zed='zeditor'

# Eza modern file listing
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons=always --group-directories-first'
  alias la='eza -a --icons=always --group-directories-first'
  alias ll='eza -al --icons=always --group-directories-first'
  alias lt='eza -a --tree --level=2 --icons=always --group-directories-first'
fi

# Git shortcuts
alias gs="git status"
alias ga="git add"
alias gc="git commit -m"
alias gp="git push"
alias gpl="git pull"
alias gst="git stash"
alias gsp="git stash; git pull"
alias gfo="git fetch origin"
alias gcheck="git checkout"

# Dotfiles repository management
alias dotfiles='/usr/bin/git -C $HOME/mydotfiles'
alias mydotfiles='/usr/bin/git -C $HOME/mydotfiles'

# Container & Project Task Dispatcher
alias docker=podman
alias pt='$HOME/.local/bin/project-task'
alias ptr='$HOME/.local/bin/project-task run'
alias ptt='$HOME/.local/bin/project-task test'
alias ptl='$HOME/.local/bin/project-task lint'
alias ptf='$HOME/.local/bin/project-task format'

# Yazi CWD synchronization wrapper: `y` opens yazi and cds on quit
if command -v yazi >/dev/null 2>&1; then
  function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    command yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
      builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
  }
fi

# TMUX — shared session management
if command -v tmux >/dev/null 2>&1; then
  alias ta='tmux attach-session -t main 2>/dev/null || tmux new-session -s main'
  alias tn='tmux new-session -A -s main'
  alias tl='tmux ls'
  unalias tk 2>/dev/null
  tk() {
    if [ $# -gt 0 ]; then
      tmux kill-session -t "$1"
    else
      tmux kill-session
    fi
  }
  alias td='tmux detach-client'
fi

# jcode: claude-code-style /model shortcut (routes through omniroute profile when installed)
if (( $+commands[jcode] )); then
  jcode() {
    if [ "$1" = "/model" ]; then
      shift
      if [ $# -eq 0 ]; then
        command jcode --provider-profile omniroute
      else
        local m="$1"; shift
        if [ $# -gt 0 ]; then
          command jcode run --provider-profile omniroute -m "$m" "$@"
        else
          command jcode --provider-profile omniroute -m "$m"
        fi
      fi
      return
    fi
    command jcode "$@"
  }
fi

# OmniRoute user-service aliases (loaded in interactive shells only, not ~/.zshenv)
if ! alias omnion >/dev/null 2>&1; then
  [ -f "$HOME/.omni-aliases.zsh" ] && source "$HOME/.omni-aliases.zsh"
fi

# Desktop / ML4W helper commands (graceful fallback if running in container / standard distro)
if [ -d "$HOME/.config/ml4w" ]; then
  alias screenshot='$HOME/.config/ml4w/bin/ml4w-screenshot'
  alias wallpaper='$HOME/.config/ml4w/bin/ml4w-wallpaper'
  alias lock='hyprlock'
fi

# Optional local overrides (machine-specific credentials or environment)
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
