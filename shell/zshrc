# ============================================================================
# mydotfiles — Unified Autonomous Zsh Configuration (~/.zshrc)
# High-performance, self-contained, and dual-profile aware (Kitty & WezTerm)
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Fast-Boot Flags & Environment Foundations
# ---------------------------------------------------------------------------
export EDITOR="nvim"
export VISUAL="nvim"
export BROWSER="/usr/bin/helium-browser"

export ZSH="$HOME/.oh-my-zsh"
export ZSH_DISABLE_COMPFIX="true"
export DISABLE_AUTO_UPDATE="true"
export DISABLE_UPDATE_PROMPT="true"
export ZSH_COMPDUMP="$HOME/.zcompdump-${HOST}-${ZSH_VERSION}"

# Deduplicate PATH automatically in zsh
typeset -U path PATH

# Go
export GOPATH="$HOME/go"
[ -d "$GOPATH/bin" ] && path=("$GOPATH/bin" $path)

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
[ -d "$PNPM_HOME" ] && path=("$PNPM_HOME" $path)

# Bun
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && path=("$BUN_INSTALL/bin" $path)

# Node global packages & user binaries
[ -d "$HOME/.npm-global/bin" ] && path=("$HOME/.npm-global/bin" $path)
[ -d "$HOME/.cargo/bin" ] && path=("$HOME/.cargo/bin" $path)
[ -d "$HOME/.local/bin" ] && path=("$HOME/.local/bin" $path)
[ -d "$HOME/bin" ] && path=("$HOME/bin" $path)

# Clean non-existent directories from PATH
path=($^path(N-/))

# Podman (rootless) Docker socket
export DOCKER_HOST="unix:///run/user/${EUID:-1000}/podman/podman.sock"

# ---------------------------------------------------------------------------
# 2. Oh-My-Zsh Core & Pinned Plugins (Lean Native Loader)
# ---------------------------------------------------------------------------
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

if [ -d "$ZSH" ]; then
  [ -f "$ZSH/lib/key-bindings.zsh" ] && source "$ZSH/lib/key-bindings.zsh"
  [ -f "$ZSH/lib/completion.zsh" ]   && source "$ZSH/lib/completion.zsh"
  [ -f "$ZSH/lib/history.zsh" ]      && source "$ZSH/lib/history.zsh"

  # Fast cached compinit (-C skips checking newer completion definitions on every boot)
  autoload -Uz compinit
  compinit -C -d "${ZSH_COMPDUMP:-$HOME/.zcompdump-${HOST}-${ZSH_VERSION}}"

  # Load core plugins directly
  [ -f "$ZSH/plugins/git/git.plugin.zsh" ]   && source "$ZSH/plugins/git/git.plugin.zsh"
  [ -f "$ZSH/plugins/sudo/sudo.plugin.zsh" ] && source "$ZSH/plugins/sudo/sudo.plugin.zsh"
  [ -f "$ZSH_CUSTOM/plugins/fzf-tab/fzf-tab.plugin.zsh" ] && source "$ZSH_CUSTOM/plugins/fzf-tab/fzf-tab.plugin.zsh"
  [ -f "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && source "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [ -f "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && source "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Multi-distro portable FZF keybindings & completion
for _fzf_dir in /usr/share/fzf /usr/local/opt/fzf/shell /opt/homebrew/opt/fzf/shell /usr/share/doc/fzf/examples "$HOME/.fzf/shell"; do
  if [ -d "$_fzf_dir" ]; then
    [ -f "$_fzf_dir/key-bindings.zsh" ] && source "$_fzf_dir/key-bindings.zsh"
    [ -f "$_fzf_dir/completion.zsh" ]   && source "$_fzf_dir/completion.zsh"
    break
  fi
done
unset _fzf_dir

# ---------------------------------------------------------------------------
# 3. Zsh History
# ---------------------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt appendhistory hist_ignore_all_dups hist_reduce_blanks sharehistory

# ---------------------------------------------------------------------------
# 4. Modern Tools (Cached Inits for Zero Startup Latency)
# ---------------------------------------------------------------------------

# zoxide: smarter cd -> use `z <partial-name>`
_zoxide_cache="$HOME/.cache/zsh-cache/zoxide.zsh"
if [[ -f "$_zoxide_cache" ]]; then
  source "$_zoxide_cache"
elif command -v zoxide >/dev/null 2>&1; then
  mkdir -p "${_zoxide_cache:h}"
  zoxide init zsh > "$_zoxide_cache" 2>/dev/null && source "$_zoxide_cache" || eval "$(zoxide init zsh)"
fi

# direnv: per-directory environment switching
_direnv_cache="$HOME/.cache/zsh-cache/direnv.zsh"
if [[ -f "$_direnv_cache" ]]; then
  source "$_direnv_cache"
elif command -v direnv >/dev/null 2>&1; then
  mkdir -p "${_direnv_cache:h}"
  direnv hook zsh > "$_direnv_cache" 2>/dev/null && source "$_direnv_cache" || eval "$(direnv hook zsh)"
fi

# mise: per-project tool versions (node/python/go/bun) — shims on PATH, lazy activate CLI
export PATH="$HOME/.local/share/mise/shims:$PATH"
mise() {
  unset -f mise
  eval "$(command /usr/bin/mise activate zsh)"
  mise "$@"
}

# atuin: synced, searchable shell history — takes over Ctrl+R
_atuin_cache="$HOME/.cache/zsh-cache/atuin.zsh"
if [[ -f "$_atuin_cache" ]]; then
  source "$_atuin_cache"
elif command -v atuin >/dev/null 2>&1; then
  mkdir -p "${_atuin_cache:h}"
  atuin init zsh > "$_atuin_cache" 2>/dev/null && source "$_atuin_cache" || eval "$(atuin init zsh)"
fi

# fzf: fd-backed sources + nice UI + bat preview (Ctrl-/ toggles preview)
export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git --exclude node_modules"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git --exclude node_modules"
export FZF_DEFAULT_OPTS="--height=45% --layout=reverse --border=rounded --info=inline \
  --preview 'bat --color=always --style=numbers --line-range=:300 {1}' \
  --bind 'ctrl-/:toggle-preview'"

# ---------------------------------------------------------------------------
# 5. Dual Profile Architecture: Kitty (Dev Nightfox) vs WezTerm (Wallpaper Matugen)
# ---------------------------------------------------------------------------
_is_kitty=0
_is_wezterm=0

if [[ -n "$KITTY_WINDOW_ID" || "$TERMINAL_STACK_PROFILE" == "kitty" ]]; then
  _is_kitty=1
elif [[ -n "$WEZTERM_PANE" || "$TERMINAL_STACK_PROFILE" == "wezterm" ]]; then
  _is_wezterm=1
fi

if [[ "$_is_kitty" -eq 1 ]]; then
  # --- KITTY DEV PROFILE (Nightfox) ---
  if command -v oh-my-posh >/dev/null 2>&1; then
    _omp_cache="$HOME/.cache/zsh-cache/omp-nightfox.zsh"
    if [[ -f "$_omp_cache" && "$HOME/.config/ohmyposh/zen-nightfox.toml" -ot "$_omp_cache" ]]; then
      source "$_omp_cache"
    else
      mkdir -p "${_omp_cache:h}"
      oh-my-posh init zsh --config "$HOME/.config/ohmyposh/zen-nightfox.toml" > "$_omp_cache" 2>/dev/null && source "$_omp_cache" || eval "$(oh-my-posh init zsh --config "$HOME/.config/ohmyposh/zen-nightfox.toml")"
    fi
  fi

  export BAT_THEME="nightfox"
  export FZF_DEFAULT_OPTS="--height=45% --layout=reverse --border=rounded --info=inline \
    --color=bg+:#212e3f,bg:-1,spinner:#719cd6,hl:#719cd6 \
    --color=fg:#cdcecf,header:#719cd6,info:#828f9f,pointer:#719cd6 \
    --color=marker:#81b29a,fg+:#cdcecf,prompt:#719cd6,hl+:#719cd6,border:#719cd6 \
    --preview 'bat --color=always --style=numbers --line-range=:300 {1}' \
    --bind 'ctrl-/:toggle-preview'"
  export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/theme-nightfox.yml"
  export CONFIG_DIR="$HOME/.config/lazydocker/nightfox"

  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#575860"

  typeset -A ZSH_HIGHLIGHT_STYLES 2>/dev/null || true
  ZSH_HIGHLIGHT_STYLES[default]="none"
  ZSH_HIGHLIGHT_STYLES[unknown-token]="fg=#c94f6d,bold"
  ZSH_HIGHLIGHT_STYLES[reserved-word]="fg=#9d79d6,bold"
  ZSH_HIGHLIGHT_STYLES[alias]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[suffix-alias]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[global-alias]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[builtin]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[function]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[command]="fg=#719cd6,bold"
  ZSH_HIGHLIGHT_STYLES[precommand]="fg=#c94f6d,bold"
  ZSH_HIGHLIGHT_STYLES[hashed-command]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[autodirectory]="fg=#dbc074"
  ZSH_HIGHLIGHT_STYLES[path]="fg=#dbc074"
  ZSH_HIGHLIGHT_STYLES[path_prefix]="fg=#dbc074"
  ZSH_HIGHLIGHT_STYLES[path_approx]="fg=#c94f6d"
  ZSH_HIGHLIGHT_STYLES[commandseparator]="fg=#cdcecf"
  ZSH_HIGHLIGHT_STYLES[redirection]="fg=#cdcecf"
  ZSH_HIGHLIGHT_STYLES[history-expansion]="fg=#c94f6d"
  ZSH_HIGHLIGHT_STYLES[comment]="fg=#575860,italic"
  ZSH_HIGHLIGHT_STYLES[assign]="fg=#81b29a"
  ZSH_HIGHLIGHT_STYLES[arg0]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[globbing]="fg=#dbc074,bold"
  ZSH_HIGHLIGHT_STYLES[back-quoted-argument]="fg=#81b29a"
  ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]="fg=#cdcecf"
  ZSH_HIGHLIGHT_STYLES[rc-quote]="fg=#81b29a"
  ZSH_HIGHLIGHT_STYLES[bracket-error]="fg=#c94f6d,bold"
  ZSH_HIGHLIGHT_STYLES[cursor-matchingbracket]="fg=#719cd6,bold"

elif [[ "$_is_wezterm" -eq 1 ]]; then
  # --- WEZTERM IMMERSION PROFILE (Matugen Dynamic) ---
  if command -v oh-my-posh >/dev/null 2>&1; then
    _omp_zen_cache="$HOME/.cache/zsh-cache/omp-zen.zsh"
    if [[ -f "$_omp_zen_cache" && "$HOME/.config/ohmyposh/zen.toml" -ot "$_omp_zen_cache" ]]; then
      source "$_omp_zen_cache"
    else
      mkdir -p "${_omp_zen_cache:h}"
      oh-my-posh init zsh --config "$HOME/.config/ohmyposh/zen.toml" > "$_omp_zen_cache" 2>/dev/null && source "$_omp_zen_cache" || eval "$(oh-my-posh init zsh --config "$HOME/.config/ohmyposh/zen.toml")"
    fi
  fi

  # OSC 7 directory reporting: keeps new WezTerm tabs/splits in the current directory
  _wezterm_osc7() {
    printf '\e]7;file://%s%s\e\\' "$HOST" "$PWD"
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _wezterm_osc7

  export OPENCODE_TUI_CONFIG="$HOME/.config/opencode/tui-wezterm.json"
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#9b8f80"

  typeset -A ZSH_HIGHLIGHT_STYLES 2>/dev/null || true
  ZSH_HIGHLIGHT_STYLES[default]="none"
  ZSH_HIGHLIGHT_STYLES[unknown-token]="fg=#ffb4ab,bold"
  ZSH_HIGHLIGHT_STYLES[reserved-word]="fg=#f3bd6e,bold"
  ZSH_HIGHLIGHT_STYLES[alias]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[suffix-alias]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[global-alias]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[builtin]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[function]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[command]="fg=#d8dee9,bold"
  ZSH_HIGHLIGHT_STYLES[precommand]="fg=#ffb4ab,bold"
  ZSH_HIGHLIGHT_STYLES[hashed-command]="fg=#d8dee9"
  ZSH_HIGHLIGHT_STYLES[autodirectory]="fg=#f3bd6e"
  ZSH_HIGHLIGHT_STYLES[path]="fg=#f3bd6e"
  ZSH_HIGHLIGHT_STYLES[path_prefix]="fg=#f3bd6e"
  ZSH_HIGHLIGHT_STYLES[path_approx]="fg=#ffb4ab"
  ZSH_HIGHLIGHT_STYLES[commandseparator]="fg=#ede0d4"
  ZSH_HIGHLIGHT_STYLES[redirection]="fg=#ede0d4"
  ZSH_HIGHLIGHT_STYLES[history-expansion]="fg=#ffb4ab"
  ZSH_HIGHLIGHT_STYLES[comment]="fg=#9b8f80,italic"
  ZSH_HIGHLIGHT_STYLES[assign]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[arg0]="fg=#d8dee9"
  ZSH_HIGHLIGHT_STYLES[globbing]="fg=#f3bd6e,bold"
  ZSH_HIGHLIGHT_STYLES[back-quoted-argument]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]="fg=#ede0d4"
  ZSH_HIGHLIGHT_STYLES[rc-quote]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[bracket-error]="fg=#ffb4ab,bold"
  ZSH_HIGHLIGHT_STYLES[cursor-matchingbracket]="fg=#ede0d4,bold"

  [ -f "$HOME/.cache/zsh-wallpaper.zsh" ] && source "$HOME/.cache/zsh-wallpaper.zsh"

else
  # --- GENERIC / SSH / TTY FALLBACK ---
  if command -v oh-my-posh >/dev/null 2>&1; then
    _omp_fallback="$HOME/.cache/zsh-cache/omp-fallback.zsh"
    if [[ -f "$_omp_fallback" && "$HOME/.config/ohmyposh/zen.toml" -ot "$_omp_fallback" ]]; then
      source "$_omp_fallback"
    else
      mkdir -p "${_omp_fallback:h}"
      oh-my-posh init zsh --config "$HOME/.config/ohmyposh/zen.toml" > "$_omp_fallback" 2>/dev/null && source "$_omp_fallback" || eval "$(oh-my-posh init zsh --config "$HOME/.config/ohmyposh/zen.toml")"
    fi
  fi
fi

# ---------------------------------------------------------------------------
# 6. Aliases & Functions
# ---------------------------------------------------------------------------

# General navigation & tools
alias ..='cd ..'
alias c='clear'
alias nf='fastfetch'
alias pf='fastfetch'
alias ff='fastfetch'
alias v='$EDITOR'
alias vim='$EDITOR'
alias zed='zeditor'

# Eza modern file listing
if command -v eza >/dev/null 2>&1; then
  alias ls='eza -a --icons=always'
  alias ll='eza -al --icons=always'
  alias lt='eza -a --tree --level=1 --icons=always'
fi

# Git shortcuts
alias gs="git status"
alias ga="git add"
alias gc="git commit -m"
alias gp="git push"
alias gpl="git pull"
alias gst="git stash"
alias gsp="git stash; git pull"
alias gfo="git fetch origin"
alias gcheck="git checkout"

# Dotfiles repository management
alias dotfiles='/usr/bin/git -C $HOME/mydotfiles'
alias mydotfiles='/usr/bin/git -C $HOME/mydotfiles'

# Container & Project Task Dispatcher
alias docker=podman
alias pt='$HOME/.local/bin/project-task'
alias ptr='$HOME/.local/bin/project-task run'
alias ptt='$HOME/.local/bin/project-task test'
alias ptl='$HOME/.local/bin/project-task lint'
alias ptf='$HOME/.local/bin/project-task format'

# TMUX — shared session management
if command -v tmux >/dev/null 2>&1; then
  alias ta='tmux attach-session -t main 2>/dev/null || tmux new-session -s main'
  alias tn='tmux new-session -s main'
  alias tk='tmux ls'
  alias td='tmux detach-client'
fi

# jcode: claude-code-style /model (routes through omniroute profile)
jcode() {
  if [ "$1" = "/model" ]; then
    shift
    if [ $# -eq 0 ]; then
      command jcode --provider-profile omniroute
    else
      local m="$1"; shift
      if [ $# -gt 0 ]; then
        command jcode run --provider-profile omniroute -m "$m" "$@"
      else
        command jcode --provider-profile omniroute -m "$m"
      fi
    fi
    return
  fi
  command jcode "$@"
}

# Omni-Aliases & Custom Shortcuts (if present)
[ -f "$HOME/.omni-aliases.zsh" ] && source "$HOME/.omni-aliases.zsh"
[ -f "$HOME/mydotfiles/shell/omni-aliases.zsh" ] && source "$HOME/mydotfiles/shell/omni-aliases.zsh"

# Desktop / ML4W helper commands (graceful fallback if running in container / standard distro)
if [ -d "$HOME/.config/ml4w" ]; then
  alias screenshot='$HOME/.config/ml4w/bin/ml4w-screenshot'
  alias wallpaper='$HOME/.config/ml4w/bin/ml4w-wallpaper'
  alias lock='hyprlock'
fi

# Optional local overrides (machine-specific credentials or environment)
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
