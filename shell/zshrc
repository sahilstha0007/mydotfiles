# ============================================================================
# mydotfiles — Unified Autonomous Zsh Configuration (~/.zshrc)
# High-performance, self-contained, and dual-profile aware (Kitty & WezTerm)
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Fast-Boot Flags & Environment Foundations
# ---------------------------------------------------------------------------
export EDITOR="nvim"
export VISUAL="nvim"
# Detect first available browser (fallback to xdg-open if present)
for _browser in helium-browser brave chromium google-chrome firefox xdg-open; do
  if (( $+commands[$_browser] )); then
    export BROWSER="$commands[$_browser]"
    break
  fi
done
unset _browser

export ZSH="$HOME/.oh-my-zsh"
export ZSH_DISABLE_COMPFIX="true"
export DISABLE_AUTO_UPDATE="true"
export DISABLE_UPDATE_PROMPT="true"
export ZSH_COMPDUMP="$HOME/.zcompdump-${HOST}-${ZSH_VERSION}"

# Deduplicate PATH automatically in zsh
typeset -U path PATH

# Go
export GOPATH="$HOME/go"
[ -d "$GOPATH/bin" ] && path=("$GOPATH/bin" $path)

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
[ -d "$PNPM_HOME" ] && path=("$PNPM_HOME" $path)

# Bun
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && path=("$BUN_INSTALL/bin" $path)

# Node global packages & user binaries
[ -d "$HOME/.npm-global/bin" ] && path=("$HOME/.npm-global/bin" $path)
[ -d "$HOME/.cargo/bin" ] && path=("$HOME/.cargo/bin" $path)
[ -d "$HOME/.local/bin" ] && path=("$HOME/.local/bin" $path)
[ -d "$HOME/bin" ] && path=("$HOME/bin" $path)

# Clean non-existent directories from PATH
path=($^path(N-/))

# Podman (rootless) Docker socket
export DOCKER_HOST="unix:///run/user/${EUID:-1000}/podman/podman.sock"

# ---------------------------------------------------------------------------
# 2. Oh-My-Zsh Core & Pinned Plugins (Lean Native Loader)
# ---------------------------------------------------------------------------
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

if [ -d "$ZSH" ]; then
  [ -f "$ZSH/lib/key-bindings.zsh" ] && source "$ZSH/lib/key-bindings.zsh"
  [ -f "$ZSH/lib/completion.zsh" ]   && source "$ZSH/lib/completion.zsh"
  [ -f "$ZSH/lib/history.zsh" ]      && source "$ZSH/lib/history.zsh"

  # Add custom completions to fpath BEFORE compinit
  [ -d "$ZSH_CUSTOM/plugins/zsh-completions/src" ] && fpath=("$ZSH_CUSTOM/plugins/zsh-completions/src" $fpath)

  # Fast cached compinit (-C skips checking newer completion definitions on every boot)
  autoload -Uz compinit
  compinit -C -d "${ZSH_COMPDUMP:-$HOME/.zcompdump-${HOST}-${ZSH_VERSION}}"

  # Load core plugins directly
  [ -f "$ZSH/plugins/git/git.plugin.zsh" ]   && source "$ZSH/plugins/git/git.plugin.zsh"
  [ -f "$ZSH/plugins/sudo/sudo.plugin.zsh" ] && source "$ZSH/plugins/sudo/sudo.plugin.zsh"
  [ -f "$ZSH_CUSTOM/plugins/fzf-tab/fzf-tab.plugin.zsh" ] && source "$ZSH_CUSTOM/plugins/fzf-tab/fzf-tab.plugin.zsh"

  # fzf-tab styling & contextual previews (bat for files, eza for directories, ps for kill)
  zstyle ':completion:*:git-checkout:*' sort false
  zstyle ':completion:*:descriptions' format '[%d]'
  zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
  zstyle ':completion:*' menu no
  zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always --icons=always $realpath'
  zstyle ':fzf-tab:complete:z:*' fzf-preview 'eza -1 --color=always --icons=always $realpath'
  zstyle ':fzf-tab:complete:(nvim|vim|nano|bat|cat):*' fzf-preview '[[ -d $realpath ]] && eza -1 --color=always --icons=always $realpath || bat --color=always --line-range=:200 $realpath 2>/dev/null'
  zstyle ':fzf-tab:complete:kill:argument-rest' fzf-preview 'ps --pid=$word -o cmd --no-headers -w -w'
  zstyle ':fzf-tab:complete:kill:argument-rest' fzf-flags '--preview-window=down:3:wrap'
  zstyle ':fzf-tab:*' continuous-trigger '/'

  [ -f "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && source "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [ -f "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && source "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Multi-distro portable FZF keybindings & completion
# Atuin (initialized below) owns Ctrl+R when installed; suppress FZF's redundant Ctrl+R widget
# while preserving Ctrl+T (files) and Alt+C (cd into directory).
(( $+commands[atuin] )) && FZF_CTRL_R_COMMAND=""
for _fzf_dir in /usr/share/fzf /usr/local/opt/fzf/shell /opt/homebrew/opt/fzf/shell /usr/share/doc/fzf/examples "$HOME/.fzf/shell"; do
  if [ -d "$_fzf_dir" ]; then
    [ -f "$_fzf_dir/key-bindings.zsh" ] && source "$_fzf_dir/key-bindings.zsh"
    [ -f "$_fzf_dir/completion.zsh" ]   && source "$_fzf_dir/completion.zsh"
    break
  fi
done
unset _fzf_dir
(( $+commands[atuin] )) && unset FZF_CTRL_R_COMMAND

# ---------------------------------------------------------------------------
# 3. Zsh History
# ---------------------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt appendhistory hist_ignore_all_dups hist_reduce_blanks sharehistory

# ---------------------------------------------------------------------------
# 4. Modern Tools (Cached Inits for Zero Startup Latency, Binary-Mtime Checked)
# ---------------------------------------------------------------------------
_zsh_cached_init() {
  local bin="$commands[$1]" cache="$2" dep="$3"
  shift 3
  [[ -n "$bin" ]] || return 0
  if [[ ! -s "$cache" || ! "$bin" -ot "$cache" || ( -n "$dep" && -e "$dep" && ! "$dep" -ot "$cache" ) ]]; then
    mkdir -p "${cache:h}"
    "$@" >| "$cache" 2>/dev/null || { eval "$("$@")"; return; }
  fi
  source "$cache"
}

# zoxide: smarter cd -> use `z <partial-name>`
_zsh_cached_init zoxide "$HOME/.cache/zsh-cache/zoxide.zsh" "" zoxide init zsh

# direnv: per-directory environment switching
_zsh_cached_init direnv "$HOME/.cache/zsh-cache/direnv.zsh" "" direnv hook zsh

# mise: per-project tool versions (node/python/go/bun) — shims on PATH, lazy activate CLI
[ -d "$HOME/.local/share/mise/shims" ] && path=("$HOME/.local/share/mise/shims" $path)
if (( $+commands[mise] )); then
  mise() {
    unset -f mise
    eval "$(command mise activate zsh)"
    mise "$@"
  }
fi

# atuin: synced, searchable shell history — takes over Ctrl+R and Up-arrow bindings
_zsh_cached_init atuin "$HOME/.cache/zsh-cache/atuin.zsh" "" atuin init zsh

# fzf: fd-backed sources + per-mode previews (Ctrl-T files -> bat, Alt-C dirs -> eza)
export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git --exclude node_modules"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git --exclude node_modules"
export FZF_DEFAULT_OPTS="--height=45% --layout=reverse --border=rounded --info=inline \
  --bind 'ctrl-/:toggle-preview'"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:300 {1}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons=always --color=always {}'"

# ---------------------------------------------------------------------------
# 5. Dual Profile Architecture: Kitty Primary (Nightfox) vs WezTerm Fallback (Matugen)
# ---------------------------------------------------------------------------
# Explicit TERMINAL_STACK_PROFILE wins first so attaching to a shared tmux
# server from a different terminal is never hijacked by stale KITTY_WINDOW_ID /
# WEZTERM_PANE variables captured at server startup.
_is_kitty=0
_is_wezterm=0

if [[ "$TERMINAL_STACK_PROFILE" == "kitty" ]]; then
  _is_kitty=1
elif [[ "$TERMINAL_STACK_PROFILE" == "wezterm" ]]; then
  _is_wezterm=1
elif [[ -n "$KITTY_WINDOW_ID" ]]; then
  _is_kitty=1
elif [[ -n "$WEZTERM_PANE" ]]; then
  _is_wezterm=1
fi

_omp_init_cached() {
  local cfg="$1" cache="$2"
  _zsh_cached_init oh-my-posh "$cache" "$cfg" oh-my-posh init zsh --config "$cfg"
  # Each shell needs its own POSH_SESSION_ID rather than sharing one baked into the cache
  [[ -r /proc/sys/kernel/random/uuid ]] && export POSH_SESSION_ID="$(</proc/sys/kernel/random/uuid)"
}

if [[ "$_is_kitty" -eq 1 ]]; then
  # --- KITTY DEV PROFILE (Nightfox) ---
  _omp_init_cached "$HOME/.config/ohmyposh/zen-nightfox.toml" "$HOME/.cache/zsh-cache/omp-nightfox.zsh"

  export BAT_THEME="nightfox"
  export FZF_DEFAULT_OPTS="--height=45% --layout=reverse --border=rounded --info=inline \
    --color=bg+:#212e3f,bg:-1,spinner:#719cd6,hl:#719cd6 \
    --color=fg:#cdcecf,header:#719cd6,info:#828f9f,pointer:#719cd6 \
    --color=marker:#81b29a,fg+:#cdcecf,prompt:#719cd6,hl+:#719cd6,border:#719cd6 \
    --bind 'ctrl-/:toggle-preview'"
  export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/theme-nightfox.yml"
  export CONFIG_DIR="$HOME/.config/lazydocker/nightfox"

  # Nightfox theme for btop under Kitty when no explicit -c/--config is passed
  btop() {
    case " $* " in
      *" -c "*|*" --config "*) command btop "$@" ;;
      *) command btop -c "$HOME/.config/btop/btop-nightfox.conf" "$@" ;;
    esac
  }

  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#575860"

  typeset -A ZSH_HIGHLIGHT_STYLES 2>/dev/null || true
  ZSH_HIGHLIGHT_STYLES[default]="none"
  ZSH_HIGHLIGHT_STYLES[unknown-token]="fg=#c94f6d,bold"
  ZSH_HIGHLIGHT_STYLES[reserved-word]="fg=#9d79d6,bold"
  ZSH_HIGHLIGHT_STYLES[alias]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[suffix-alias]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[global-alias]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[builtin]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[function]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[command]="fg=#719cd6,bold"
  ZSH_HIGHLIGHT_STYLES[precommand]="fg=#c94f6d,bold"
  ZSH_HIGHLIGHT_STYLES[hashed-command]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[autodirectory]="fg=#dbc074"
  ZSH_HIGHLIGHT_STYLES[path]="fg=#dbc074"
  ZSH_HIGHLIGHT_STYLES[path_prefix]="fg=#dbc074"
  ZSH_HIGHLIGHT_STYLES[path_approx]="fg=#c94f6d"
  ZSH_HIGHLIGHT_STYLES[commandseparator]="fg=#cdcecf"
  ZSH_HIGHLIGHT_STYLES[redirection]="fg=#cdcecf"
  ZSH_HIGHLIGHT_STYLES[history-expansion]="fg=#c94f6d"
  ZSH_HIGHLIGHT_STYLES[comment]="fg=#575860,italic"
  ZSH_HIGHLIGHT_STYLES[assign]="fg=#81b29a"
  ZSH_HIGHLIGHT_STYLES[arg0]="fg=#719cd6"
  ZSH_HIGHLIGHT_STYLES[globbing]="fg=#dbc074,bold"
  ZSH_HIGHLIGHT_STYLES[back-quoted-argument]="fg=#81b29a"
  ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]="fg=#cdcecf"
  ZSH_HIGHLIGHT_STYLES[rc-quote]="fg=#81b29a"
  ZSH_HIGHLIGHT_STYLES[bracket-error]="fg=#c94f6d,bold"
  ZSH_HIGHLIGHT_STYLES[cursor-matchingbracket]="fg=#719cd6,bold"

elif [[ "$_is_wezterm" -eq 1 ]]; then
  # --- WEZTERM IMMERSION PROFILE (Matugen Dynamic) ---
  _omp_init_cached "$HOME/.config/ohmyposh/zen.toml" "$HOME/.cache/zsh-cache/omp-zen.zsh"

  # OSC 7 directory reporting: keeps new WezTerm tabs/splits in the current directory
  _wezterm_osc7() {
    printf '\e]7;file://%s%s\e\\' "$HOST" "$PWD"
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _wezterm_osc7

  export BAT_THEME="ansi"
  export OPENCODE_TUI_CONFIG="$HOME/.config/opencode/tui-wezterm.json"
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#9b8f80"

  typeset -A ZSH_HIGHLIGHT_STYLES 2>/dev/null || true
  ZSH_HIGHLIGHT_STYLES[default]="none"
  ZSH_HIGHLIGHT_STYLES[unknown-token]="fg=#ffb4ab,bold"
  ZSH_HIGHLIGHT_STYLES[reserved-word]="fg=#f3bd6e,bold"
  ZSH_HIGHLIGHT_STYLES[alias]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[suffix-alias]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[global-alias]="fg=#b7cea2"
  ZSH_HIGHLIGHT_STYLES[builtin]="fg=#b7cea2"
