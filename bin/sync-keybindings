def resolve_repo_root() -> pathlib.Path:
    env = os.environ.get("DOTFILES_REPO_ROOT")
    if env:
        return pathlib.Path(env).resolve()
    return pathlib.Path(__file__).resolve().parents[1]


def _humanize_wez_key(table: str, raw_left: str) -> tuple[str, str]:
    """Return (display_key, canonical_key) for a WezTerm show-keys binding."""
    left_clean = re.sub(r"\s{2,}", " ", raw_left.strip()).replace(" (Physical)", "")
    tokens = left_clean.split(" ")
    key = tokens[-1]
    mods_str = " ".join(tokens[:-1]).strip()
    mods = [m.strip() for m in mods_str.split("|") if m.strip()] if mods_str else []

    mod_pretty = {"ALT": "Alt", "CTRL": "Ctrl", "SHIFT": "Shift", "SUPER": "Super", "LEADER": "Leader"}
    canon_mods = "+".join(sorted(mods))
    if table == "default":
        if "LEADER" in mods:
            other = [mod_pretty.get(m, m) for m in mods if m != "LEADER"]
            disp = f"Leader > {' + '.join([*other, key])}"
        elif mods:
            disp = " + ".join([*(mod_pretty.get(m, m) for m in mods), key])
        else:
            disp = key
        canon = f"default:{canon_mods}:{key}" if canon_mods else f"default::{key}"
    else:
        chord = " + ".join([*(mod_pretty.get(m, m) for m in mods), key]) if mods else key
        disp = f"[{table}] {chord}"
        canon = f"{table}:{canon_mods}:{key}" if canon_mods else f"{table}::{key}"
    return disp, canon


