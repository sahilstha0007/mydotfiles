def _describe_wez_action(canon: str, raw_action: str, cb_labels: dict[str, str]) -> str:
    if canon in cb_labels:
        return cb_labels[canon]
    if raw_action in WEZTERM_ACTION_LABELS:
        return WEZTERM_ACTION_LABELS[raw_action]
    if raw_action.startswith("ShowLauncherArgs") and "TABS" in raw_action:
        return "Fuzzy tab switcher (Launcher)"
    if raw_action.startswith("ShowLauncherArgs") and "WORKSPACES" in raw_action:
        return "Fuzzy workspace switcher (Launcher)"
    if raw_action.startswith("CharSelect"):
        return "Unicode / Nerd Font / emoji symbol picker"
    if raw_action.startswith("ActivateKeyTable"):
        m = re.search(r'name:\s*"([^"]+)"', raw_action)
        return f"Activate {m.group(1)} key table" if m else raw_action
    if raw_action.startswith("AdjustPaneSize"):
        m = re.search(r'AdjustPaneSize\(([^)]+)\)', raw_action)
        return f"Resize pane ({m.group(1)})" if m else raw_action
    if raw_action.startswith("EmitEvent"):
        return raw_action
    return raw_action


def collect_wezterm(repo_root: pathlib.Path) -> list[dict[str, str]]:
    cfg = repo_root / ".config" / "wezterm" / "wezterm.lua"
    proc = subprocess.run(
        ["wezterm", "--config-file", str(cfg), "show-keys"],
        capture_output=True,
        text=True,
        check=True,
    )
    skip_tables = {"copy_mode", "search_mode"}
    cb_labels = _wezterm_callback_labels(repo_root)
    rows: list[dict[str, str]] = []
    seen: set[str] = set()
    section = ""

    for line in proc.stdout.splitlines():
        s = line.strip()
        if s == "Default key table":
            section = "default"
        elif s.startswith("Key Table:"):
            section = s.split(":", 1)[1].strip()
        elif s == "Mouse":
            section = "mouse"
        elif section and section != "mouse" and section not in skip_tables and "->" in line:
            left, right = line.split("->", 1)
            raw_act = " ".join(right.strip().split())
            disp, canon = _humanize_wez_key(section, left)
            if canon in seen:
                continue
            seen.add(canon)
            desc = _describe_wez_action(canon, raw_act, cb_labels)
            scope = "Default" if section == "default" else f"Table:{section}"
            rows.append(
                {
                    "layer": "WezTerm",
                    "scope": scope,
                    "key": disp,
                    "canon": f"WezTerm|{canon}",
                    "action": desc,
                }
            )
    return rows


def collect_kitty(repo_root: pathlib.Path) -> list[dict[str, str]]:
    conf = repo_root / ".config" / "kitty" / "custom.conf"
    rows: list[dict[str, str]] = []
    seen: set[str] = set()
    for line in conf.read_text(encoding="utf-8").splitlines():
        m = re.match(r"^\s*map\s+(\S+)\s+(.*)$", line)
        if not m:
            continue
        combo, cmd = m.group(1), m.group(2).strip()
        canon = f"Kitty|{combo.lower()}"
        if canon in seen:
            continue
        seen.add(canon)
        scope = "Leader >" if ">" in combo else "Keys"
        disp_cmd = cmd.replace("$HOME/.config/kitty/scripts/", "").replace("~/.config/kitty/scripts/", "")
        rows.append(
            {
                "layer": "Kitty",
                "scope": scope,
                "key": combo,
                "canon": canon,
                "action": disp_cmd,
            }
        )
    return rows


def collect_tmux(repo_root: pathlib.Path) -> list[dict[str, str]]:
    conf = repo_root / ".config" / "tmux" / "tmux.conf"
    with tempfile.TemporaryDirectory(prefix="sync-kbd-tmux-") as tmp_sock_dir:
        sock_env = {**os.environ, "TMUX_TMPDIR": tmp_sock_dir}
        sock = f"devcheck-kbd-sync-{os.getpid()}"
        try:
            start = subprocess.run(
                ["tmux", "-L", sock, "-f", str(conf), "new-session", "-d", "-s", "kbd-probe"],
                capture_output=True,
                text=True,
                env=sock_env,
            )
            if start.returncode != 0:
                raise RuntimeError(f"tmux start-server failed: {start.stderr.strip()}")
            live_proc = subprocess.run(
                ["tmux", "-L", sock, "list-keys"],
                capture_output=True,
                text=True,
                env=sock_env,
                check=True,
            )
        finally:
            subprocess.run(["tmux", "-L", sock, "kill-server"], capture_output=True, env=sock_env)

    live_map: dict[tuple[str, str], str] = {}
    for line in live_proc.stdout.splitlines():
        m = re.match(r'^bind-key\s+(?:-\S+\s+)*-T\s+(\S+)\s+(?:-N\s+"[^"]*"\s+)?(\S+)\s+(.*)$', line)
        if m:
            tbl, key, cmd = m.group(1), m.group(2).replace("\\", ""), m.group(3)
            key = TMUX_KEY_ALIASES.get(key, key)
            live_map[(tbl, key)] = cmd

    # Keep user-declared binds from tmux.conf (verified active in live_map)
    ordered_by_pair: dict[tuple[str, str], str] = {}
    for raw in conf.read_text(encoding="utf-8").splitlines():
        s = raw.strip()
        if not s or s.startswith("#"):
            continue
        m = re.match(r"^bind(?:-key)?\s+(.*)$", s)
        if not m:
            continue
        toks = m.group(1).split()
        tbl = "prefix"
        i = 0
        while i < len(toks):
            tok = toks[i]
            if tok == "-r":
                i += 1
            elif tok == "-n":
                tbl = "root"
                i += 1
            elif tok == "-T" and i + 1 < len(toks):
                tbl = toks[i + 1]
                i += 2
            else:
                break
        if i >= len(toks):
            continue
        key = TMUX_KEY_ALIASES.get(toks[i].replace("\\", ""), toks[i].replace("\\", ""))
        if (tbl, key) not in live_map:
            raise RuntimeError(f"tmux.conf bind ({tbl}, {key}) missing in live tmux list-keys")
        ordered_by_pair[(tbl, key)] = live_map[(tbl, key)]

    rows: list[dict[str, str]] = []
    for (tbl, key), cmd in ordered_by_pair.items():
        if tbl == "prefix":
            disp = f"Prefix + {key}"
            scope = "Prefix"
        elif tbl == "root":
            disp = f"[root] {key}"
            scope = "Root"
        else:
            disp = f"[{tbl}] {key}"
            scope = tbl
        rows.append(
            {
                "layer": "Tmux",
                "scope": scope,
                "key": disp,
                "canon": f"Tmux|{tbl}:{key}",
                "action": cmd,
            }
        )
    return rows


def collect_all(repo_root: pathlib.Path) -> list[dict[str, str]]:
    return [*collect_wezterm(repo_root), *collect_kitty(repo_root), *collect_tmux(repo_root)]


def render_cheatsheet_block(rows: list[dict[str, str]]) -> str:
    entries = [(r["layer"], r["key"], r["action"], r["scope"], r["canon"]) for r in rows]
    formatted = pprint.pformat(entries, width=116, sort_dicts=False)
    return "# BEGIN GENERATED KEYBINDINGS\nGENERATED_ENTRIES = " + formatted + "\n# END GENERATED KEYBINDINGS"


def render_readme_block(rows: list[dict[str, str]]) -> str:
    counts = {}
    for r in rows:
        counts[r["layer"]] = counts.get(r["layer"], 0) + 1
    lines = [
        "<!-- BEGIN KEYBINDINGS -->",
        "### Keybindings Master Overview",
        "",
        "- **Neovim Leader**: `Space` (`Space+e` nvim-tree, `-` Oil, `Space+ff/fg/sg` pickers, `Space+P` project tasks)",
        "- **Tmux Prefix**: `Ctrl+a` (`Prefix+|/-` splits, `Prefix+f` Project Hub, `Prefix+S` session switcher, `Prefix+k` cross-layer keymap dump)",
        "- **Kitty Dev**: `Ctrl+Shift+<key>` (`d/s` splits, `t/w` tabs, `f/h` scrollback, `g/y/m/o` overlays, `Ctrl+Shift+Space` QuickSelect, `Ctrl+Shift+p > ...` hints)",
        "- **WezTerm Leader**: `Alt+Ctrl+Space` (`w` workspaces, `f` font resize, `p` pane resize; `Alt+o` backdrop panel, `Alt+p` wallpaper picker, `Alt+s` switch workspace)",
        "- **Universal Cross-Layer Navigation**: `Ctrl+h/j/k/l` moves seamlessly across Kitty/Tmux splits and Neovim splits, and `terminal-cheatsheet` searches the full keybind table interactively.",
        "",
        "<details>",
        f"<summary>Complete Live Keybinding Reference ({len(rows)} generated bindings: "
        + ", ".join(f"{k} {v}" for k, v in counts.items())
        + ")</summary>",
        "",
        "| Layer | Scope | Key | Action | Canonical ID |",
        "|---|---|---|---|---|",
    ]
    for r in rows:
        def esc(s: str) -> str:
            return s.replace("|", "\\|").replace("`", "\\`")

        lines.append(
            f"| {esc(r['layer'])} | {esc(r['scope'])} | `{esc(r['key'])}` | {esc(r['action'])} | `{esc(r['canon'])}` |"
        )
    lines.extend(["", "</details>", "<!-- END KEYBINDINGS -->"])
    return "\n".join(lines)


def parse_readme_canons(readme_text: str) -> set[str]:
    m = re.search(r"<!-- BEGIN KEYBINDINGS -->(.*?)<!-- END KEYBINDINGS -->", readme_text, re.S)
    if not m:
        raise RuntimeError("README.md missing <!-- BEGIN KEYBINDINGS --> markers")
    canons: set[str] = set()
    for line in m.group(1).splitlines():
        if not line.startswith("| "):
            continue
        if line.startswith("| Layer |") or line.startswith("|---"):
            continue
        # Last column holds canonical id inside backticks
        m_id = re.search(r"`([^`]+)`\s*\|\s*$", line)
        if m_id:
            canons.add(m_id.group(1).replace("\\|", "|").replace("\\`", "`"))
    return canons


def parse_cheatsheet_canons(repo_root: pathlib.Path) -> set[str]:
    script = repo_root / "bin" / "terminal-cheatsheet"
    proc = subprocess.run(["python3", str(script), "--json"], capture_output=True, text=True, check=True)
    data = json.loads(proc.stdout)
    return {item["canon"] for item in data if item.get("canon")}


def replace_block(path: pathlib.Path, start_marker: str, end_marker: str, new_block: str) -> bool:
    text = path.read_text(encoding="utf-8")
    pattern = re.escape(start_marker) + r".*?" + re.escape(end_marker)
    if not re.search(pattern, text, re.S):
        raise RuntimeError(f"{path} missing {start_marker} .. {end_marker}")
    updated = re.sub(pattern, lambda _: new_block, text, count=1, flags=re.S)
    if updated != text:
        path.write_text(updated, encoding="utf-8")
        return True
    return False


def main(argv: list[str]) -> int:
    check_only = False
    for a in argv[1:]:
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--check":
            check_only = True
        else:
            print(f"sync-keybindings: unknown option: {a}", file=sys.stderr)
            return 2

    repo_root = resolve_repo_root()
    rows = collect_all(repo_root)
    live_canons = {r["canon"] for r in rows}

    if not check_only:
        cs_changed = replace_block(
            repo_root / "bin" / "terminal-cheatsheet",
            "# BEGIN GENERATED KEYBINDINGS",
            "# END GENERATED KEYBINDINGS",
            render_cheatsheet_block(rows),
        )
        rm_changed = replace_block(
            repo_root / "README.md",
            "<!-- BEGIN KEYBINDINGS -->",
            "<!-- END KEYBINDINGS -->",
            render_readme_block(rows),
        )
        print(
            f"sync-keybindings: synced {len(rows)} live bindings "
            f"(cheatsheet={'updated' if cs_changed else 'unchanged'}, "
            f"readme={'updated' if rm_changed else 'unchanged'})"
        )
        return 0

    cs_canons = parse_cheatsheet_canons(repo_root)
    rm_canons = parse_readme_canons((repo_root / "README.md").read_text(encoding="utf-8"))

    errors: list[str] = []
    for name, doc_canons in (("terminal-cheatsheet", cs_canons), ("README.md", rm_canons)):
        missing = sorted(live_canons - doc_canons)
        extra = sorted(doc_canons - live_canons)
        if missing:
            errors.append(f"{name}: missing {len(missing)} live binding(s): {missing[:5]}")
        if extra:
            errors.append(f"{name}: has {len(extra)} non-live/stale binding(s): {extra[:5]}")

    if errors:
        for e in errors:
            print(f"FAIL: {e}", file=sys.stderr)
        return 1

    print(f"PASS: 1:1 keybinding parity ({len(live_canons)} live bindings == cheatsheet == README.md)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
