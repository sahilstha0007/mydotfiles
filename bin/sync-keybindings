#!/usr/bin/env python3
"""Synchronize and verify 1:1 parity between live WezTerm/Kitty/Tmux keybindings
and both bin/terminal-cheatsheet and README.md (Work Item E4).

Usage:
    sync-keybindings          Regenerate cheatsheet & README keybinding tables
    sync-keybindings --check  Verify 1:1 parity without modifying files (exit 1 on drift)
"""

from __future__ import annotations

import json
import os
import pathlib
import pprint
import re
import subprocess
import sys
import tempfile

TMUX_KEY_ALIASES = {
    "PageUp": "PPage",
    "PageDown": "NPage",
}

