#!/usr/bin/env bash
# G2: Non-destructive live reload across tmux, kitty, and wezterm configs.
# Never kills tmux sessions, nvim buffers, or running zsh shells.
set -euo pipefail

DRY_RUN=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      cat <<'EOF'
Usage: stack-reload [--dry-run] [--help]

Safely reloads live terminal stack configs without killing sessions or shells:
  - tmux:    `tmux source-file ~/.config/tmux/tmux.conf` + `on-client-attached.sh`
  - kitty:   sends SIGUSR1 / `load-config` via active @kitty-* unix sockets
  - wezterm: triggers config hot-reload on ~/.config/wezterm/wezterm.lua
EOF
      exit 0
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    *)
      printf 'stack-reload: unknown option: %s\nUsage: stack-reload [--dry-run] [--help]\n' "$1" >&2
      exit 2
      ;;
  esac
done

run_or_echo() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY-RUN: %s\n' "$*"
  else
    "$@"
  fi
}

STAMP_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/terminal-stack-reload"

proc_start_ticks() {
  local pid="$1" stat_line rest
  [ -r "/proc/$pid/stat" ] || return 1
  stat_line=$(<"/proc/$pid/stat")
  rest="${stat_line##*) }"
  local -a fields
  read -ra fields <<< "$rest"
  [ -n "${fields[19]:-}" ] || return 1
  printf '%s' "${fields[19]}"
}

record_reload_stamps() {
  local layer="$1"
  shift
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY-RUN: record reload stamp for %s (%s)\n' "$layer" "$*"
    return 0
  fi
  [ "$#" -gt 0 ] || return 0
  mkdir -p "$STAMP_DIR"
  chmod 700 "$STAMP_DIR" 2>/dev/null || true
  local stamp_file="$STAMP_DIR/${layer}.stamps"
  local tmp_file
  tmp_file=$(mktemp "${stamp_file}.XXXXXX")
  local pid ticks ts
  ts=$(date +%s)
  for pid in "$@"; do
    [ -n "$pid" ] || continue
    if ticks=$(proc_start_ticks "$pid"); then
      printf '%s:%s:%s\n' "$pid" "$ticks" "$ts" >> "$tmp_file"
    fi
  done
  if [ -s "$tmp_file" ]; then
    mv -f "$tmp_file" "$stamp_file"
  else
    rm -f "$tmp_file"
  fi
}

echo "==> Reloading terminal stack (non-destructive)..."

# 1. Tmux live server
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  run_or_echo tmux source-file "$HOME/.config/tmux/tmux.conf"
  if [ -x "$HOME/.config/tmux/scripts/on-client-attached.sh" ] && [ -n "$(tmux list-clients 2>/dev/null || true)" ]; then
    run_or_echo bash "$HOME/.config/tmux/scripts/on-client-attached.sh" || true
  fi
  tmux_pid=$(tmux display-message -p '#{pid}' 2>/dev/null || pgrep -u "$(id -u)" -x 'tmux: server' | head -1 || true)
  [ -n "$tmux_pid" ] && record_reload_stamps tmux "$tmux_pid"
  echo "  [OK] tmux config reloaded and attached profile synced"
else
  echo "  [SKIP] no active tmux server under current TMUX_TMPDIR"
fi

SELF_PATH=$(readlink -f -- "${BASH_SOURCE[0]}")
REPO_ROOT=$(cd -- "$(dirname -- "$SELF_PATH")/.." && pwd -P)

# 2. Kitty live instances (sanitize matugen output before reload + socket-only RC + SIGUSR1 fallback)
if command -v kitty >/dev/null 2>&1; then
  SANITIZER=$(command -v kitty-colors-sanitize 2>/dev/null || printf '%s' "$REPO_ROOT/bin/kitty-colors-sanitize")
  if [ -x "$SANITIZER" ] && [ -f "$HOME/.config/kitty/colors-matugen.conf" ]; then
    run_or_echo "$SANITIZER" --sync-in \
      --in "$HOME/.config/kitty/colors-matugen.conf" \
      --out "$HOME/.config/kitty/colors-matugen.validated.conf" >/dev/null || true
  fi
  kitty_reloaded=0
  kitty_reloaded_pids=()
  if [ -r /proc/net/unix ]; then
    while IFS= read -r sock; do
      [ -n "$sock" ] || continue
      if run_or_echo kitty @ --to "unix:${sock}" load-config >/dev/null 2>&1; then
        kitty_reloaded=$((kitty_reloaded + 1))
        kitty_reloaded_pids+=("${sock#@kitty-}")
      fi
    done < <(grep -oE '@kitty-[0-9]+' /proc/net/unix 2>/dev/null | sort -u || true)
  fi
  if [ "$kitty_reloaded" -eq 0 ] && pgrep -u "$(id -u)" -x kitty >/dev/null 2>&1; then
    run_or_echo pkill -USR1 -u "$(id -u)" -x kitty || true
    mapfile -t kitty_reloaded_pids < <(pgrep -u "$(id -u)" -x kitty 2>/dev/null || true)
    record_reload_stamps kitty "${kitty_reloaded_pids[@]}"
    echo "  [OK] kitty signaled with SIGUSR1"
  elif [ "$kitty_reloaded" -gt 0 ]; then
    record_reload_stamps kitty "${kitty_reloaded_pids[@]}"
    echo "  [OK] kitty reloaded via $kitty_reloaded remote socket(s)"
  fi
fi

# 3. WezTerm live auto-reload
if pgrep -u "$(id -u)" -x 'wezterm-gui' >/dev/null 2>&1 && [ -e "$HOME/.config/wezterm/wezterm.lua" ]; then
  run_or_echo touch -c "$HOME/.config/wezterm/wezterm.lua"
  mapfile -t wz_reloaded_pids < <(pgrep -u "$(id -u)" -x 'wezterm-gui' 2>/dev/null || true)
  record_reload_stamps wezterm "${wz_reloaded_pids[@]}"
  echo "  [OK] triggered wezterm config mtime watch"
fi

echo "==> Note: long-lived interactive shells only adopt new .zshenv/.zshrc on 'exec zsh'."
