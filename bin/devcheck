#!/usr/bin/env bash
# devcheck — one verification command for the whole dev stack.
#
#   devcheck          fast tier — run this after any change
#   devcheck --all    adds mutation harnesses, clean-clone test, wiki lint, and /tmp leak check
#
# DESIGN RULES
# * Resolve REPO_ROOT from this script (following ~/.local/bin symlink), never $HOME/mydotfiles.
# * Never skip missing tools or missing repo scripts/configs — fail loudly instead.
# * Assert at exit that every declared gate in EXPECTED_GATES actually executed (manifest check).
set -uo pipefail

SELF_PATH=$(readlink -f -- "${BASH_SOURCE[0]}")
REPO_ROOT=$(cd -- "$(dirname -- "$SELF_PATH")/.." && pwd -P)

for _extra_bin in \
  "$HOME/.local/share/mise/shims" \
  "$HOME/.local/share/nvim/mason/bin" \
  "$HOME/.luarocks/bin"; do
  if [ -d "$_extra_bin" ]; then
    case ":$PATH:" in
      *":$_extra_bin:"*) ;;
      *) PATH="$PATH:$_extra_bin" ;;
    esac
  fi
done
export PATH

RUN_ALL=0
case "${1:-}" in
  "") ;;
  --all) RUN_ALL=1 ;;
  *)
    printf 'usage: devcheck [--all]\n' >&2
    exit 2
    ;;
esac

FAST_MS=0
FAILED=0
SKIPPED=0
declare -a NAMES=() RESULTS=()

DEVCHECK_LOG=$(mktemp "${TMPDIR:-/tmp}/devcheck-log.XXXXXX")
DEVCHECK_LEAK_SELF=$(basename -- "$DEVCHECK_LOG")
trap 'rm -f "$DEVCHECK_LOG"' EXIT

# Snapshot user-owned entries in /tmp before gates execute (--all leak detector).
TMP_BEFORE=""
if [ "$RUN_ALL" -eq 1 ]; then
  TMP_BEFORE=$(find /tmp -maxdepth 1 -mindepth 1 -user "$(id -u)" -printf '%f\n' | grep -vxF "$DEVCHECK_LEAK_SELF" | sort)
fi

# --- output helpers --------------------------------------------------------
if [ -t 1 ]; then
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  R=$'\033[0m'
  GRN=$'\033[32m'
  RED=$'\033[31m'
  YLW=$'\033[33m'
else
  BOLD=''
  DIM=''
  R=''
  GRN=''
  RED=''
  YLW=''
fi

# run <name> <dir> <cmd...>
run() {
  local name="$1" dir="$2"
  shift 2
  local start
  start=$(date +%s%N)
  (cd "$dir" && "$@") >"$DEVCHECK_LOG" 2>&1
  local ec=$?
  local ms=$((($(date +%s%N) - start) / 1000000))
  FAST_MS=$((FAST_MS + ms))

  if [ "$ec" -eq 0 ]; then
    NAMES+=("$name")
    RESULTS+=("${GRN}pass${R}")
    printf '  %s%s%s  %-28s %s\n' "$BOLD" "$name" "$R" "" "${DIM}${ms}ms${R}"
    if grep -qE '^(\s*\[WARN\]|STALE \[)' "$DEVCHECK_LOG"; then
      grep -E '^(\s*\[WARN\]|STALE \[)' "$DEVCHECK_LOG" | sed "s/^/      ${YLW}/; s/\$/${R}/"
    fi
  else
    FAILED=$((FAILED + 1))
    NAMES+=("$name")
    RESULTS+=("${RED}FAIL${R}")
    printf '  %s%s%s  %-28s %sFAIL (exit %d)%s\n' "$BOLD" "$name" "$R" "" "$RED" "$ec" "$R"
    printf '%s\n' "$DIM" "$(tail -8 "$DEVCHECK_LOG" | sed 's/^/      /')" "$R"
  fi
  return 0
}

# fail <name> <reason> — missing tool or missing repo gate is always a failure
fail() {
  local name="$1" reason="$2"
  FAILED=$((FAILED + 1))
  NAMES+=("$name")
  RESULTS+=("${RED}FAIL${R}")
  printf '  %s%s%s  %-28s %sFAIL (%s)%s\n' "$BOLD" "$name" "$R" "" "$RED" "$reason" "$R"
  return 0
}

# skip <name> <reason> — only permitted for external private Atlas repo in clean-clone
skip() {
  SKIPPED=$((SKIPPED + 1))
  NAMES+=("$1")
  RESULTS+=("${YLW}skip${R} ${DIM}($2)${R}")
  printf '  %s%s%s  %-28s %s%s%s\n' "$BOLD" "$1" "$R" "" "$YLW" "$2" "$R"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1
}

printf '%sdevcheck%s  %sfast tier%s\n\n' "$BOLD" "$R" "$DIM" "$R"

# --- manifest ---------------------------------------------------------------
EXPECTED_GATES=(
  "nvim: specs"
  "nvim: fmt"
  "nvim: keymaps"
  "nvim: lint"
  "wezterm: cascade"
  "wezterm: right-status"
  "wezterm: tab-title"
  "wezterm: border"
  "wezterm: theme-source"
  "wezterm: platform"
  "wezterm: hyprland"
  "wezterm: lint"
  "wezterm: fmt"
  "keys: wezterm vs tmux"
  "tmux: colour prop"
  "tmux: profiles"
  "tmux: scripts syntax"
  "tmux: keymap dump"
  "tmux: reload idempotency"
  "cli: args & help"
  "kitty: config parse"
  "kitty: full profile"
  "kitty: collisions"
  "kitty: tab_bar specs"
  "zsh: syntax"
  "zsh: startup <= 120ms"
  "bin: python syntax"
  "repo: shellcheck"
  "tests: lua fmt"
  "tests: lua lint"
  "contrast: wcag"
  "signals: ownership"
  "docs: dead refs"
  "docs: keybindings parity"
  "docs: vs config"
  "install: doctor"
  "live: freshness"
)
if [ "$RUN_ALL" -eq 1 ]; then
  EXPECTED_GATES+=(
    "wezterm: mutation"
    "wiki: lint"
    "nvim: mutation"
    "zsh: runtime matrix"
    "install: idempotency & backup"
  )
  if [ "${DEVCHECK_IN_CLEAN_CLONE:-0}" != "1" ]; then
    EXPECTED_GATES+=("clean: clone")
  fi
  EXPECTED_GATES+=("tmp: no leaks")
fi

# --- nvim -------------------------------------------------------------------
NVIM="$REPO_ROOT/.config/nvim"
if [ -d "$NVIM" ] && require_cmd nvim; then
  run "nvim: specs" "$NVIM" ./scripts/test.sh
  if require_cmd stylua; then
    run "nvim: fmt" "$NVIM" make fmt-check
  else
    fail "nvim: fmt" "stylua not installed"
  fi
  run "nvim: keymaps" "$NVIM" make keymaps
  if require_cmd luacheck; then
    run "nvim: lint" "$NVIM" make lint
  else
    fail "nvim: lint" "luacheck not installed"
  fi
else
  for g in "nvim: specs" "nvim: fmt" "nvim: keymaps" "nvim: lint"; do
    fail "$g" "nvim or $NVIM missing"
  done
fi

# --- wezterm ----------------------------------------------------------------
WZ="$REPO_ROOT/.config/wezterm"
WZ_TESTS="$REPO_ROOT/tests/wezterm"
if [ -d "$WZ" ] && require_cmd luajit; then
  for pair in \
    "wezterm: right-status|check-right-status.lua" \
    "wezterm: tab-title|check-tab-title.lua" \
    "wezterm: border|check_border.lua" \
    "wezterm: theme-source|check_theme_source.lua" \
    "wezterm: platform|check_platform.lua" \
    "wezterm: hyprland|check_hyprland.lua"; do
    g_name="${pair%%|*}"
    g_file="$WZ_TESTS/${pair##*|}"
    if [ "$g_name" = "wezterm: right-status" ]; then
      if [ -f "$WZ_TESTS/check_wallpaper_cascade.sh" ]; then
        run "wezterm: cascade" "$WZ" bash "$WZ_TESTS/check_wallpaper_cascade.sh"
      else
        fail "wezterm: cascade" "missing $WZ_TESTS/check_wallpaper_cascade.sh"
      fi
    fi
    if [ -f "$g_file" ]; then
      run "$g_name" "$WZ" luajit "$g_file" "$WZ"
    else
      fail "$g_name" "missing $g_file"
    fi
  done

  if require_cmd luacheck; then
    run "wezterm: lint" "$WZ" luacheck .
  else
    fail "wezterm: lint" "luacheck not installed"
  fi

  if require_cmd stylua; then
    run "wezterm: fmt" "$WZ" stylua --check --config-path "$WZ/.stylua.toml" "$WZ"
  else
    fail "wezterm: fmt" "stylua not installed"
  fi

  if [ -f "$WZ/scripts/check-key-collisions.sh" ] && require_cmd wezterm && require_cmd tmux; then
    run "keys: wezterm vs tmux" "$WZ" bash scripts/check-key-collisions.sh
  else
    fail "keys: wezterm vs tmux" "check-key-collisions.sh, wezterm, or tmux missing"
  fi
else
  for g in \
    "wezterm: cascade" "wezterm: right-status" "wezterm: tab-title" \
    "wezterm: border" "wezterm: theme-source" "wezterm: platform" \
    "wezterm: hyprland" "wezterm: lint" "wezterm: fmt" "keys: wezterm vs tmux"; do
    fail "$g" "luajit or $WZ missing"
  done
fi

# --- tmux -------------------------------------------------------------------
TMUX_DIR="$REPO_ROOT/.config/tmux"
TMUX_TESTS="$REPO_ROOT/tests/tmux"
if [ -x "$TMUX_TESTS/check-colour-propagation.sh" ] && require_cmd tmux; then
  run "tmux: colour prop" "$TMUX_DIR" bash "$TMUX_TESTS/check-colour-propagation.sh"
else
  fail "tmux: colour prop" "missing check-colour-propagation.sh or tmux"
fi

if [ -x "$TMUX_TESTS/check-terminal-profiles.sh" ] && require_cmd tmux; then
  run "tmux: profiles" "$TMUX_DIR" bash "$TMUX_TESTS/check-terminal-profiles.sh"
else
  fail "tmux: profiles" "missing check-terminal-profiles.sh or tmux"
fi

if [ -f "$TMUX_DIR/scripts/on-client-attached.sh" ] && [ -f "$TMUX_DIR/scripts/status-right.sh" ]; then
  run "tmux: scripts syntax" "$TMUX_DIR" bash -n \
    "$TMUX_DIR/scripts/on-client-attached.sh" \
    "$TMUX_DIR/scripts/status-right.sh" \
    "$TMUX_DIR/scripts/auto-save-session.sh" \
    "$TMUX_DIR/colors-from-matugen.sh" \
    "$TMUX_DIR/colors-from-kitty.sh" \
    "$TMUX_DIR/keymap-dump.sh" \
    "$TMUX_DIR/project-task.sh" \
    "$TMUX_DIR/session-switcher.sh"
else
  fail "tmux: scripts syntax" "tmux scripts missing"
fi

if [ -f "$TMUX_TESTS/check-keymap-dump.sh" ] && require_cmd wezterm && require_cmd python3; then
  run "tmux: keymap dump" "$REPO_ROOT" bash "$TMUX_TESTS/check-keymap-dump.sh"
else
  fail "tmux: keymap dump" "missing check-keymap-dump.sh, wezterm, or python3"
fi

if [ -f "$TMUX_TESTS/check-reload-idempotency.sh" ] && require_cmd tmux && require_cmd python3; then
  run "tmux: reload idempotency" "$REPO_ROOT" bash "$TMUX_TESTS/check-reload-idempotency.sh"
else
  fail "tmux: reload idempotency" "missing check-reload-idempotency.sh, tmux, or python3"
fi

CLI_ARGS_CHECK="$REPO_ROOT/tests/cli/check-cli-args.sh"
if [ -f "$CLI_ARGS_CHECK" ] && require_cmd python3; then
  run "cli: args & help" "$REPO_ROOT" bash "$CLI_ARGS_CHECK"
else
  fail "cli: args & help" "missing $CLI_ARGS_CHECK or python3"
fi

# --- kitty ------------------------------------------------------------------
KITTY_DIR="$REPO_ROOT/.config/kitty"
KITTY_CUSTOM="$KITTY_DIR/custom.conf"
if [ -f "$KITTY_CUSTOM" ] && require_cmd kitty; then
  run "kitty: config parse" "$KITTY_DIR" \
    kitty --config NONE -o include="$KITTY_CUSTOM" --help
else
  fail "kitty: config parse" "missing custom.conf or kitty"
fi

KITTY_CONF="$KITTY_DIR/kitty.conf"
if [ -f "$KITTY_CONF" ] && require_cmd kitty && require_cmd python3; then
  run "kitty: full profile" "$KITTY_DIR" \
    bash -c 'python3 -m py_compile tab_bar.py pass_keys.py && kitty --config kitty.conf --help >/dev/null'
  run "kitty: collisions" "$KITTY_DIR" \
    python3 -c '
import re, subprocess, sys
lines = open("custom.conf").read().splitlines()
maps = [re.match(r"^map\s+(\S+)", l.strip()).group(1) for l in lines if l.strip().startswith("map ")]
prefixes = {k.split(">")[0] for k in maps if ">" in k}
bare = set(maps) - {k for k in maps if ">" in k}
overlap = sorted(prefixes & bare)
if overlap:
    sys.exit("Kitty key prefix overlaps bare map: " + ", ".join(overlap))
tmux_root = subprocess.run(["tmux", "list-keys", "-T", "root"], capture_output=True, text=True)
if tmux_root.returncode == 0:
    tmux_m = {m.group(1).lower() for line in tmux_root.stdout.splitlines()
              for m in [re.match(r"^bind-key\s+(?:-\S+\s+)*-T\s+root\s+M-(\S+)", line)] if m}
    kitty_alt = {k[4:].lower() for k in bare if k.lower().startswith("alt+")}
    steals = sorted(tmux_m & kitty_alt)
    if steals:
        sys.exit("Kitty bare alt+ steals tmux root M-: " + ", ".join(steals))
out = subprocess.run(["kitty", "+runpy", "from kitty.config import load_config; load_config(\"kitty.conf\")"], capture_output=True, text=True)
bad = [l for l in (out.stdout + out.stderr).splitlines() if "Ignoring invalid config line" in l]
if bad:
    sys.exit("Kitty config warnings:\n" + "\n".join(bad))
'
else
  fail "kitty: full profile" "missing kitty.conf, kitty, or python3"
  fail "kitty: collisions" "missing kitty.conf, kitty, or python3"
fi

# Invoked indirectly via `run "kitty: tab_bar specs" ... run_kitty_tab_specs`.
# shellcheck disable=SC2329
run_kitty_tab_specs() {
  local test_path="$1"
  python3 "$test_path" && DOTFILES_KITTY_DIR="$PWD" kitty +runpy "$(cat "$test_path")"
}

KITTY_TAB_TEST="$REPO_ROOT/tests/kitty/check-tab-bar.py"
if [ -f "$KITTY_TAB_TEST" ] && require_cmd kitty && require_cmd python3; then
  run "kitty: tab_bar specs" "$KITTY_DIR" run_kitty_tab_specs "$KITTY_TAB_TEST"
else
  fail "kitty: tab_bar specs" "missing check-tab-bar.py, kitty, or python3"
fi

# --- zsh --------------------------------------------------------------------
if require_cmd zsh && [ -f "$HOME/.zshrc" ] && [ -f "$HOME/.zshenv" ]; then
  run "zsh: syntax" "$HOME" zsh -n "$HOME/.zshrc" "$HOME/.zshenv"
  if require_cmd python3; then
    run "zsh: startup <= 120ms" "$HOME" \
      python3 -c '
import subprocess, time, sys
t0 = time.perf_counter()
subprocess.run(["zsh", "-i", "-c", "exit"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
ms = (time.perf_counter() - t0) * 1000
if ms > 120:
    sys.exit(f"zsh startup too slow: {ms:.1f}ms > 120ms")
'
  else
    fail "zsh: startup <= 120ms" "python3 not installed"
  fi
else
  fail "zsh: syntax" "zsh, .zshrc, or .zshenv missing"
  fail "zsh: startup <= 120ms" "zsh, .zshrc, or .zshenv missing"
fi

# --- bin & repo lint/fmt gates ----------------------------------------------
if require_cmd python3; then
  run "bin: python syntax" "$REPO_ROOT" \
    python3 -m py_compile "$REPO_ROOT/bin/project-task" "$REPO_ROOT/bin/terminal-cheatsheet" "$REPO_ROOT/bin/sync-keybindings"
else
  fail "bin: python syntax" "python3 not installed"
fi

# Invoked indirectly via `run "repo: shellcheck" ... run_repo_shellcheck`.
# shellcheck disable=SC2329
run_repo_shellcheck() {
  local -a candidates=() scripts=()
  local f first
  mapfile -t candidates < <(git ls-files "*.sh" "install.sh" "bin/*")
  for f in "${candidates[@]}"; do
    [ -f "$f" ] || continue
    first=$(head -n 1 "$f")
    case "$f" in
      *.sh) scripts+=("$f") ;;
      *)
        case "$first" in
          *zsh*) ;;
          *sh|*sh\ *|*bash*) scripts+=("$f") ;;
        esac
        ;;
    esac
  done
  shellcheck "${scripts[@]}"
}

if require_cmd shellcheck && require_cmd git; then
  run "repo: shellcheck" "$REPO_ROOT" run_repo_shellcheck
else
  fail "repo: shellcheck" "shellcheck or git not installed"
fi

if require_cmd stylua; then
  run "tests: lua fmt" "$REPO_ROOT" bash -c '
    set -euo pipefail
    stylua --check --config-path .config/nvim/stylua.toml tests/nvim
    stylua --check --config-path .config/wezterm/.stylua.toml tests/wezterm tests/.luacheckrc
  '
else
  fail "tests: lua fmt" "stylua not installed"
fi

if require_cmd luacheck; then
  run "tests: lua lint" "$REPO_ROOT/tests" luacheck .
else
  fail "tests: lua lint" "luacheck not installed"
fi

CONTRAST_CHECK="$REPO_ROOT/tests/contrast/check-contrast.py"
if [ -f "$CONTRAST_CHECK" ] && require_cmd python3; then
  run "contrast: wcag" "$REPO_ROOT" python3 "$CONTRAST_CHECK"
else
  fail "contrast: wcag" "missing $CONTRAST_CHECK or python3"
fi

OWNERSHIP_CHECK="$REPO_ROOT/tests/signals/check-ownership.py"
if [ -f "$OWNERSHIP_CHECK" ] && require_cmd python3; then
  run "signals: ownership" "$REPO_ROOT" python3 "$OWNERSHIP_CHECK"
else
  fail "signals: ownership" "missing $OWNERSHIP_CHECK or python3"
fi

DEAD_REFS_CHECK="$REPO_ROOT/tests/docs/check-dead-refs.py"
if [ -f "$DEAD_REFS_CHECK" ] && require_cmd python3; then
  run "docs: dead refs" "$REPO_ROOT" python3 "$DEAD_REFS_CHECK"
else
  fail "docs: dead refs" "missing $DEAD_REFS_CHECK or python3"
fi

KBD_SYNC="$REPO_ROOT/bin/sync-keybindings"
if [ -f "$KBD_SYNC" ] && require_cmd python3 && require_cmd wezterm && require_cmd tmux; then
  run "docs: keybindings parity" "$REPO_ROOT" python3 "$KBD_SYNC" --check
else
  fail "docs: keybindings parity" "missing $KBD_SYNC, python3, wezterm, or tmux"
fi

# --- docs vs live configs ---------------------------------------------------
DOCS_DIR="${ATLAS_DIR:-$HOME/Documents/Notes/Atlas}"
if [ -f "$DOCS_DIR/scripts/check_docs_vs_config.py" ] && require_cmd python3; then
  run "docs: vs config" "$DOCS_DIR" python3 scripts/check_docs_vs_config.py
elif [ "${DEVCHECK_IN_CLEAN_CLONE:-0}" = "1" ]; then
  skip "docs: vs config" "external Atlas vault absent in clean-clone"
else
  fail "docs: vs config" "missing $DOCS_DIR/scripts/check_docs_vs_config.py"
fi

if [ -f "$REPO_ROOT/install.sh" ]; then
  if [ "${DEVCHECK_IN_CLEAN_CLONE:-0}" = "1" ]; then
    run "install: doctor" "$REPO_ROOT" bash "$REPO_ROOT/install.sh" --doctor --strict
  else
    run "install: doctor" "$REPO_ROOT" bash "$REPO_ROOT/install.sh" --doctor
  fi
else
  fail "install: doctor" "missing $REPO_ROOT/install.sh"
fi

LIVE_FRESH="$REPO_ROOT/tests/live/check-freshness.sh"
if [ -f "$LIVE_FRESH" ] && require_cmd python3; then
  run "live: freshness" "$REPO_ROOT" bash "$LIVE_FRESH"
else
  fail "live: freshness" "missing $LIVE_FRESH or python3"
fi

# --- slow tier --------------------------------------------------------------
if [ "$RUN_ALL" -eq 1 ]; then
  if [ -f "$WZ_TESTS/mutate-check-opacity.sh" ]; then
    run "wezterm: mutation" "$WZ" bash "$WZ_TESTS/mutate-check-opacity.sh"
  else
    fail "wezterm: mutation" "missing $WZ_TESTS/mutate-check-opacity.sh"
  fi

  WLINT="$DOCS_DIR/11 - Sahil's Wiki/scripts/lint.py"
  WIKI_BASELINE=15
  if [ -f "$WLINT" ] && require_cmd python3; then
    out=$(cd "$DOCS_DIR" && python3 "11 - Sahil's Wiki/scripts/lint.py" 2>&1)
    n=$(printf '%s\n' "$out" | sed -n 's/^Lint found \([0-9]\+\) issue.*/\1/p')
    if [ -z "$n" ]; then
      if printf '%s\n' "$out" | grep -qi 'clean'; then
        NAMES+=("wiki: lint")
        printf '  %swiki: lint%s  %s\n' "$DIM" "$R" "clean"
      else
        FAILED=$((FAILED + 1))
        NAMES+=("wiki: lint")
        printf '  %swiki: lint%s  %sFAIL (linter crashed)%s\n' "$DIM" "$R" "$RED" "$R"
      fi
    elif [ "$n" -gt "$WIKI_BASELINE" ]; then
      FAILED=$((FAILED + 1))
      NAMES+=("wiki: lint")
      printf '  %swiki: lint%s  %sFAIL %d issues (baseline %d) -- %d NEW%s\n' \
        "$DIM" "$R" "$RED" "$n" "$WIKI_BASELINE" "$((n - WIKI_BASELINE))" "$R"
      printf '%s\n' "$out" | grep '^  - ' | tail -5 | sed 's/^/      /'
    else
      NAMES+=("wiki: lint")
      printf '  %swiki: lint%s  %s%d issues (baseline %d, unchanged)%s\n' \
        "$DIM" "$R" "$DIM" "$n" "$WIKI_BASELINE" "$R"
    fi
  elif [ "${DEVCHECK_IN_CLEAN_CLONE:-0}" = "1" ]; then
    skip "wiki: lint" "external Atlas vault absent in clean-clone"
  else
    fail "wiki: lint" "missing $WLINT"
  fi

  NVMUT="$REPO_ROOT/tests/nvim/mutate-terminal-colors.sh"
  if [ -f "$NVMUT" ] && require_cmd nvim; then
    run "nvim: mutation" "$REPO_ROOT" bash "$NVMUT"
  else
    fail "nvim: mutation" "missing $NVMUT or nvim"
  fi

  ZSH_RT="$REPO_ROOT/tests/shell/check-zsh-runtime.sh"
  if [ -f "$ZSH_RT" ] && require_cmd zsh; then
    run "zsh: runtime matrix" "$REPO_ROOT" bash "$ZSH_RT"
  else
    fail "zsh: runtime matrix" "missing $ZSH_RT or zsh"
  fi

  INST_TEST="$REPO_ROOT/tests/install/check-install.sh"
  if [ -f "$INST_TEST" ]; then
    run "install: idempotency & backup" "$REPO_ROOT" bash "$INST_TEST"
  else
    fail "install: idempotency & backup" "missing $INST_TEST"
  fi

  if [ "${DEVCHECK_IN_CLEAN_CLONE:-0}" != "1" ]; then
    CLEAN_TEST="$REPO_ROOT/tests/clean-clone.sh"
    if [ -f "$CLEAN_TEST" ]; then
      clean_start=$(date +%s%N)
      if ( cd "$REPO_ROOT" && bash "$CLEAN_TEST" ) > "$DEVCHECK_LOG" 2>&1; then
        clean_ms=$(( ($(date +%s%N) - clean_start) / 1000000 ))
        clean_skips=$(grep -c 'external Atlas vault absent in clean-clone' "$DEVCHECK_LOG" || true)
        clean_summary=$(sed -n 's/^all gates pass[[:space:]]*dims: \([0-9]\+\) run, \([0-9]\+\) skipped.*/\1 passed, \2 skipped/p' "$DEVCHECK_LOG" | tail -n 1)
        clean_total_skips=$(sed -n 's/^all gates pass[[:space:]]*dims: [0-9]\+ run, \([0-9]\+\) skipped.*/\1/p' "$DEVCHECK_LOG" | tail -n 1)
        if [ "${clean_total_skips:-0}" -ne "${clean_skips:-0}" ]; then
          FAILED=$((FAILED + 1))
          NAMES+=("clean: clone")
          RESULTS+=("${RED}FAIL${R}")
          printf '  %sclean: clone%s  %-28s %sFAIL (unexpected skips: %s != %s Atlas skips)%s\n' \
            "$BOLD" "$R" "" "$RED" "${clean_total_skips:-?}" "${clean_skips:-0}" "$R"
        else
          NAMES+=("clean: clone")
          RESULTS+=("${GRN}pass${R}")
          printf '  %sclean: clone%s  %-28s %s%dms%s  %s(%s; %s legitimate Atlas skips: vault absent)%s\n' \
            "$BOLD" "$R" "" "$DIM" "$clean_ms" "$R" "$DIM" "${clean_summary:-ok}" "${clean_skips:-0}" "$R"
        fi
      else
        clean_rc=$?
        FAILED=$((FAILED + 1))
        NAMES+=("clean: clone")
        RESULTS+=("${RED}FAIL${R}")
        printf '  %sclean: clone%s  %-28s %sFAIL (exit %d)%s\n' "$BOLD" "$R" "" "$RED" "$clean_rc" "$R"
        tail -12 "$DEVCHECK_LOG" | sed 's/^/      /'
      fi
    else
      fail "clean: clone" "missing $CLEAN_TEST"
    fi
  fi

  # Remove our own temp log BEFORE snapshotting /tmp for leaked entries.
  rm -f "$DEVCHECK_LOG"
  TMP_AFTER=$(find /tmp -maxdepth 1 -mindepth 1 -user "$(id -u)" -printf '%f\n' | grep -vxF "$DEVCHECK_LEAK_SELF" | sort)
  TMP_LEAKED=$(comm -13 <(printf '%s\n' "$TMP_BEFORE") <(printf '%s\n' "$TMP_AFTER"))
  if [ -z "$TMP_LEAKED" ]; then
    NAMES+=("tmp: no leaks")
    RESULTS+=("${GRN}pass${R}")
    printf '  %stmp: no leaks%s  %-28s %s\n' "$BOLD" "$R" "" "${DIM}0 leaked${R}"
  else
    FAILED=$((FAILED + 1))
    NAMES+=("tmp: no leaks")
    RESULTS+=("${RED}FAIL${R}")
    printf '  %stmp: no leaks%s  %-28s %sFAIL (leaked /tmp entries)%s\n' "$BOLD" "$R" "" "$RED" "$R"
    printf '%s\n' "$TMP_LEAKED" | sed 's/^/      /'
  fi
fi

# --- manifest self-check ----------------------------------------------------
manifest_err=""
if [ "${#NAMES[@]}" -ne "${#EXPECTED_GATES[@]}" ]; then
  manifest_err="gate count mismatch: ran ${#NAMES[@]}, expected ${#EXPECTED_GATES[@]}"
fi
exp_sorted=$(printf '%s\n' "${EXPECTED_GATES[@]}" | sort)
ran_sorted=$(printf '%s\n' "${NAMES[@]}" | sort)
if [ "$exp_sorted" != "$ran_sorted" ]; then
  diff_out=$(diff -u <(printf '%s\n' "$exp_sorted") <(printf '%s\n' "$ran_sorted") || true)
  manifest_err="${manifest_err:+$manifest_err; }manifest diff:\n$diff_out"
fi
if [ -n "$manifest_err" ]; then
  FAILED=$((FAILED + 1))
  printf '  %smanifest self-check%s %sFAIL%s\n%b\n' "$BOLD" "$R" "$RED" "$R" "$manifest_err"
fi

# --- verdict ----------------------------------------------------------------
printf '\n'
if [ "$FAILED" -ne 0 ]; then
  printf '%s%d gate(s) FAILED%s   %s%d passed, %d skipped, %dms%s\n' \
    "$RED" "$FAILED" "$R" "$DIM" "$(( ${#NAMES[@]} - FAILED - SKIPPED ))" "$SKIPPED" "$FAST_MS" "$R"
  exit 1
fi
printf '%sall gates pass%s   %sdims: %d run, %d skipped (skips are NOT passes)%s\n' \
  "$GRN" "$R" "$DIM" "$(( ${#NAMES[@]} - SKIPPED ))" "$SKIPPED" "$R"
exit 0
