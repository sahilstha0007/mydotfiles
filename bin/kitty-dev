#!/usr/bin/env bash
# =============================================================================
# kitty-dev: Launch Kitty with the Dev profile
# Starts directly into a pristine interactive shell (no chunky UI popups).
# Use project-hub, Ctrl+Shift+o, tmux, or nvim on your own when needed.
# =============================================================================
export TERMINAL_STACK_PROFILE=kitty
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/theme-nightfox.yml"
export CONFIG_DIR="$HOME/.config/lazydocker/nightfox"
exec kitty --class kitty-dev --app-id kitty-dev --title "Kitty (Dev)" --config "$HOME/.config/kitty/dev.conf" "$@"
