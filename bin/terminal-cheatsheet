def all_entries() -> list[tuple[str, str, str, str, str]]:
    return [*GENERATED_ENTRIES, *CURATED_ENTRIES]


def render_fzf(popup: bool = False) -> None:
    lines = []
    for cat, key, action, ctx, _ in all_entries():
        lines.append(f"[{cat:^7}] {key:<32} │ {action:<52} │ {ctx}")
    input_text = "\n".join(lines)
    header = "Terminal Stack Cheatsheet (WezTerm / Kitty / Tmux / Neovim / Shell) [Esc to exit]"
    fzf_cmd = [
        "fzf",
        "--ansi",
        "--header", header,
        "--prompt", "Search Keybinds > ",
        "--layout", "reverse",
        "--border", "rounded",
        "--height", "100%" if popup else "60%",
    ]
    try:
        subprocess.run(fzf_cmd, input=input_text, text=True)
    except FileNotFoundError:
        render_table()


def render_table() -> None:
    bold = "\033[1m"
    cyan = "\033[36m"
    green = "\033[32m"
    dim = "\033[2m"
    reset = "\033[0m"
    print(f"\n{bold}{cyan}=== UNIFIED TERMINAL STACK CHEATSHEET ==={reset}\n")
    current_cat = ""
    for cat, key, action, ctx, _ in all_entries():
        if cat != current_cat:
            current_cat = cat
            print(f"\n{bold}{green}--- {cat.upper()} ---{reset}")
        print(f"  {bold}{key:<32}{reset} │ {action:<52} │ {dim}{ctx}{reset}")
    print()


def render_json() -> None:
    payload = [
        {"layer": cat, "key": key, "action": action, "scope": ctx, "canon": canon}
        for cat, key, action, ctx, canon in all_entries()
    ]
    print(json.dumps(payload, indent=2))


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    mode = "auto"
    popup = False

    for arg in args:
        if arg in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if arg == "--table":
            mode = "table"
        elif arg == "--json":
            mode = "json"
        elif arg == "--popup":
            popup = True
        else:
            print(
                f"terminal-cheatsheet: unknown option: {arg}\n"
                "Usage: terminal-cheatsheet [--table] [--popup] [--json] [--help]",
                file=sys.stderr,
            )
            return 2

    if mode == "json":
        render_json()
    elif mode == "table" or not sys.stdin.isatty() or not shutil.which("fzf"):
        render_table()
    else:
        render_fzf(popup=popup)
    return 0


if __name__ == "__main__":
    sys.exit(main())
