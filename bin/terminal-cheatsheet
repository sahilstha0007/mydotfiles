def render_fzf() -> None:
    lines = []
    for cat, key, action, ctx in CHEATSHEET_ENTRIES:
        lines.append(f"[{cat:^7}] {key:<26} │ {action:<52} │ {ctx}")
    input_text = "\n".join(lines)
    header = "Terminal Stack Cheatsheet (Kitty / WezTerm / Tmux / Neovim / Shell) [Esc to exit]"
    fzf_cmd = [
        "fzf",
        "--ansi",
        "--header", header,
        "--prompt", "Search Keybinds > ",
        "--layout", "reverse",
        "--border", "rounded",
        "--height", "100%" if "--popup" in sys.argv else "60%",
    ]
    try:
        subprocess.run(fzf_cmd, input=input_text, text=True)
    except FileNotFoundError:
        render_table()


def render_table() -> None:
    bold = "\033[1m"
    cyan = "\033[36m"
    green = "\033[32m"
    dim = "\033[2m"
    reset = "\033[0m"
    print(f"\n{bold}{cyan}=== UNIFIED TERMINAL STACK CHEATSHEET ==={reset}\n")
    current_cat = ""
    for cat, key, action, ctx in CHEATSHEET_ENTRIES:
        if cat != current_cat:
            current_cat = cat
            print(f"\n{bold}{green}--- {cat.upper()} ---{reset}")
        print(f"  {bold}{key:<26}{reset} │ {action:<52} │ {dim}{ctx}{reset}")
    print()


def main() -> None:
    if "--table" in sys.argv or not sys.stdin.isatty() or not shutil.which("fzf"):
        render_table()
    else:
        render_fzf()


if __name__ == "__main__":
    main()
